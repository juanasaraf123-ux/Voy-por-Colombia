# Configuración local y secretos (se crea sola en la primera visita)
.env
.env.backup
.env.production
auth.json

# Base de datos local y archivos generados en tiempo de ejecución
/storage/database.sqlite*
/storage/*.key
/storage/pail
/public/hot
/public/storage
*.log

# Archivos subidos desde el panel (se respaldan aparte).
# Se incluyen solo las imágenes de marca y de demostración que usan las bases incluidas.
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/demo/
!/public/uploads/marca/

# Dependencias de desarrollo. /vendor (sin herramientas de desarrollo) y /public/build
# SÍ se incluyen para que el sitio funcione en XAMPP sin instalar Composer ni Node.
/node_modules
.phpunit.result.cache
/.phpunit.cache
.DS_Store
Thumbs.db
/.idea
/.vscode
/.fleet
/.zed
/.nova
.phpactor.json
Homestead.json
Homestead.yaml
