# ------------------------------------------------------------------
# Voy por Colombia — configuración de entorno
# OPCIONAL. Sin .env el sitio usa la configuración estándar de XAMPP
# (MySQL en 127.0.0.1, base "voy_por_colombia", usuario root sin contraseña).
# Solo crea ".env" (copia de este archivo) si tu servidor es diferente. Nunca subas .env al repositorio.
# ------------------------------------------------------------------

APP_NAME="Voy por Colombia"
# URL pública del sitio, sin barra final (se usa para enlaces absolutos al compartir).
# Vacío = se detecta sola.
APP_URL=
# Subcarpeta del sitio (por ejemplo "/voy-por-colombia"). Vacío = se detecta sola.
APP_BASE_PATH=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota

# --- Base de datos ---
# mysql (MySQL 5.7+ / MariaDB 10.3+, valor por defecto) o sqlite (desarrollo / pruebas)
DB_DRIVER=mysql
DB_PATH=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=voy_por_colombia
DB_USER=root
DB_PASS=

# --- Sesiones ---
SESSION_LIFETIME_MINUTES=120
# Activa cookies "Secure" (true cuando el sitio funciona con HTTPS). Si se deja vacío se detecta automáticamente.
SESSION_SECURE=
# true solo si el sitio está detrás de un proxy/balanceador de confianza que envía X-Forwarded-*.
TRUST_PROXY=false

# --- Archivos multimedia (límites en MB) ---
UPLOAD_MAX_IMAGE_MB=12
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_AUDIO_MB=40
UPLOAD_MAX_DOC_MB=20
IMAGE_QUALITY=80

# --- Mapa base opcional (capa de calles/relieve bajo el mapa ilustrado) ---
# Vacío = el mapa usa solo los polígonos de departamentos y municipios (sin servicios externos).
# Ejemplo OpenStreetMap (respeta su política de uso: https://operations.osmfoundation.org/policies/tiles/):
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; colaboradores de OpenStreetMap
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# --- Instalador web en un hosting (en localhost/XAMPP no hace falta) ---
# Define un token largo y aleatorio, visita /admin/instalar?token=EL_TOKEN para crear la primera cuenta
# y luego BORRA este valor. El instalador se bloquea solo cuando ya existe una cuenta.
SETUP_TOKEN=
