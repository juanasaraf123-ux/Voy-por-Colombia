# ------------------------------------------------------------------
# Voy por Colombia — configuración
# En XAMPP NO hace falta tocar nada: en la primera visita se crea .env automáticamente
# (con una clave secreta propia del equipo) y se usa la base SQLite incluida.
# Nunca subas .env al repositorio.
# ------------------------------------------------------------------
APP_NAME="Voy por Colombia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Vacío = se detecta sola (incluida la subcarpeta, por ejemplo http://localhost/voy-por-colombia).
APP_URL=

# --- Base de datos ---
# sqlite (por defecto, sin instalar nada), mysql, mariadb o pgsql (PostgreSQL).
DB_CONNECTION=sqlite
# Con MySQL/MariaDB/PostgreSQL completa estos datos y ejecuta «php artisan vpc:install --demo»
# (o importa database/voy_por_colombia.sql en phpMyAdmin si usas MySQL):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=voy_por_colombia
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# true cuando el sitio funciona con HTTPS
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
MAIL_MAILER=log

# --- Archivos multimedia (límites en MB) ---
UPLOAD_MAX_IMAGE_MB=12
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_AUDIO_MB=40
UPLOAD_MAX_DOC_MB=20
IMAGE_QUALITY=80

# --- Mapa base opcional (capa de calles/relieve bajo el mapa ilustrado) ---
# Ejemplo OpenStreetMap (respeta su política de uso: https://operations.osmfoundation.org/policies/tiles/):
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION="&copy; colaboradores de OpenStreetMap"
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# --- Primera cuenta en un hosting sin consola (en localhost/XAMPP no hace falta) ---
# Token largo y aleatorio: visita /admin/instalar?token=EL_TOKEN y luego borra este valor.
SETUP_TOKEN=
