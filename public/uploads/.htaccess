# Los archivos subidos nunca se ejecutan como código.
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh|asp|aspx|jsp|html?|svgz?|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .php8
RemoveType .php .phtml
Header set X-Content-Type-Options "nosniff"
